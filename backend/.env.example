# Copie para .env e preencha. NUNCA envie o .env para o GitHub.
# MySQL (formato: mysql+pymysql://USUARIO:SENHA@HOST:PORTA/BANCO)
DATABASE_URL=mysql+pymysql://USUARIO:SENHA@localhost:3306/foco
# Gere uma chave longa e aleatória: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=480
# Origens permitidas no CORS, separadas por vírgula
CORS_ORIGINS=http://localhost:4200
