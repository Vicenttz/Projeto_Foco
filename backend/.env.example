# OPCIONAL. Sem este arquivo o projeto roda com SQLite (backend/foco.db) e uma chave gerada sozinha.
# Para usar MySQL, copie para .env e preencha:
# DATABASE_URL=mysql+pymysql://USUARIO:SENHA@localhost:3306/foco
# SECRET_KEY=  (gere com: python -c "import secrets; print(secrets.token_urlsafe(48))")
ACCESS_TOKEN_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:4200
# Contas de teste (aluno@foco.com e admin@foco.com). Coloque false em produção.
SEED_DEMO=true
# OPCIONAL: mensagem diária escrita pela IA (Gemini). Sem chave, o assistente usa regras locais.
# Atenção: com a chave definida, a agenda do usuário é enviada à API do Google para gerar o texto.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
